#!/usr/bin/env bash
{
  # shellcheck disable=SC2168
  local IMPLEMENT="Docker"
  # shellcheck disable=SC2168
  local PREFIX_MAIN="${IMPLEMENT,,}.tasks.main"

  _mod_ITEMS=(
    "${IMPLEMENT,,}:build,        $PREFIX_MAIN.dc_build,                Build or Re-Build the project containers"
    "${IMPLEMENT,,}:ps,           $PREFIX_MAIN.dc_show_container,       Show Process Status"
    "${IMPLEMENT,,}:start,        $PREFIX_MAIN.dc_start,                Start containers of project"
    "${IMPLEMENT,,}:restart,      $PREFIX_MAIN.dc_restart,              Restart containers of project"
    "${IMPLEMENT,,}:stop,         $PREFIX_MAIN.dc_stop,                 Stop containers of project"
    "${IMPLEMENT,,}:logs,         $PREFIX_MAIN.dc_logs,                 Inspect environment logs"
    "${IMPLEMENT,,}:entry,        $PREFIX_MAIN.container_entry,         Enter the indicated container"
    "${IMPLEMENT,,}:commands,     $PREFIX_MAIN.container_run_command,   Run command in container. Example: bash, cp, rm"
    "${IMPLEMENT,,}:allstop,      $PREFIX_MAIN.dc_all_stop,             Stops all containers running on the computer"
    "${IMPLEMENT,,}:down,         $PREFIX_MAIN.dc_down,                 Destroy all project containers and networks"
    "${IMPLEMENT,,}:recipe,       $PREFIX_MAIN.recipe_see,              See recipe docker-compose.yml"

    "apache:stop,                 $PREFIX_MAIN.apache_stop,             Apache2 stop service"
  )
}