#!/usr/bin/env bash
set -euo pipefail

_mod_.main(){
  common.tasks.menu.show \
    --title "$docker_props_menu_TITLE" \
    --data "${docker_props_menu_MAIN[@]}"
}

_mod_.build(){
  docker.tasks.main.dc_build
  _mod_.main
}

_mod_.show(){
  docker.tasks.main.dc_show_container --quit true
  _mod_.main
}

_mod_.start(){
  docker.tasks.main.dc_start
  _mod_.main
}

_mod_.restart(){
  docker.tasks.main.dc_restart
  _mod_.main
}

_mod_.stop(){
  docker.tasks.main.dc_stop
  _mod_.main
}

_mod_.stop_all(){
  docker.tasks.main.dc_all_stop
  _mod_.main
}

_mod_.apache_stop(){
  docker.tasks.main.apache_stop
  _mod_.main
}

_mod_.down(){
  docker.tasks.main.dc_down
  _mod_.main
}

_mod_.logs(){
  docker.tasks.main.dc_logs
  _mod_.main
}

_mod_.entry(){
  docker.tasks.main.container_entry
  _mod_.main
}

_mod_.command(){
  docker.tasks.main.container_run_command
  _mod_.main
}

_mod_.recipe_see(){
  docker.tasks.main.recipe_see
  _mod_.main
}
