#!/usr/bin/env bash
set -euo pipefail

_mod_.exists() {
  [ -e "$1" ]
}

# USE
#
# common.tasks.file.remove "$PATH_FILE"
_mod_.remove() {
  local FORCE=false FILE_PATH
  [[ "$1" == "force" ]] && { FORCE=true; shift; }
  FILE_PATH="$1"
  if [[ -z "$FILE_PATH" ]]; then
    common.tasks.message.info "Usage: _mod_.remove [force] <path file>"
    return 1
  fi

  if [[ ! -e "$FILE_PATH" ]]; then
    common.tasks.message.danger "Error: Path file '$FILE_PATH' does not exist."
    return 1
  fi

  local CONFIRM="Delete FILE"
  local CONFIRM_COLOR=$(common.tasks.message.msg_color danger "$CONFIRM")
  local QUESTION=$(common.tasks.message.msg_color warning "Confirm this action by writing '$CONFIRM_COLOR':")
  common.tasks.message.warning "We are about to delete the file $(common.tasks.message.msg_color info "$FILE_PATH")"
  local RESPONSE=$(common.tasks.prompt.request_input "$QUESTION")
  if [[ "$RESPONSE" == "$CONFIRM" ]]; then
    [[ "$FORCE" == true ]] && /bin/rm -f "$FILE_PATH" || /bin/rm "$FILE_PATH"
    common.tasks.message.success "Removed: $FILE_PATH"
  else
    common.tasks.message.warning "Removal aborted."
  fi
}
