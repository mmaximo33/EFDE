#!/usr/bin/env bash
set -euo pipefail

_mod_.request_url_and_clone_repository(){
   local -A MSG=(
    [INFO]=$(common.tasks.message.msg_color info "Enter the url of your repository")
    [REQUEST]=$(common.tasks.message.msg_color warning "Enter URL (https):")
   )

  local REPOSITORY_URL=$(common.tasks.prompt.request_input "${MSG['INFO']}\n${MSG['REQUEST']}")
  common.tasks.command_line.run true false "git clone $REPOSITORY_URL $(pwd)/app"
}
